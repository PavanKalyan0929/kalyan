# Server & Domain Configuration
NODE_ENV="development"
PORT="3000"
APP_BASE_URL="http://localhost:3000"
ASH_PROPOSED_DOMAIN="www.ashstudenthub.com"
ALLOWED_ORIGINS="http://localhost:3000"

# Cloud SQL for PostgreSQL (automatically injected in Cloud Run / AI Studio Cloud SQL runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Private Upload Storage Path
UPLOAD_DIR="./storage/uploads"

# Optional Local AI (Ollama) — Recommended lightweight 16GB RAM model: llama3.2:3b or qwen2.5:3b
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"

# Optional SMS OTP Provider — Leave empty to keep SMS OTP disabled honestly
SMS_PROVIDER_ID=""
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID="ASHEDU"

# Optional Email Service (SMTP) — Leave empty to keep email delivery disabled cleanly
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@ashstudenthub.com"

# Optional Payment Gateway (e.g. Razorpay) — Never simulate payments when unconfigured
PAYMENT_PROVIDER=""
PAYMENT_PROVIDER_KEY_ID=""
PAYMENT_PROVIDER_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Optional Gemini API Key (Not required for core application features)
GEMINI_API_KEY=""

# Optional Student Counsellor WhatsApp Redirect Number (Digits only with country code, e.g. 91XXXXXXXXXX)
COUNSELLOR_WHATSAPP_NUMBER=""

